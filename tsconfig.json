{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "exactOptionalPropertyTypes": true,
    "types": [
      "bun"
    ]
  },
  "include": [
    "compiler",
    "bun-pg-client",
    "contract",
    "examples"
  ],
  "exclude": [
    "**/build/**",
    "**/.targets/**",
    "**/rust/**",
    "node_modules"
  ]
}
