{
  "name": "effect2rust",
  "version": "0.1.0",
  "description": "Write the server once in Effect; compile it to a native Rust binary that behaves identically. Plus BunPgClient: an Effect SqlClient on Bun's native Postgres driver.",
  "type": "module",
  "private": true,
  "bin": {
    "effect2rust": "./compiler/src/cli.ts",
    "effect2rust-contract": "./contract/contract.ts"
  },
  "exports": {
    "./BunPgClient": "./bun-pg-client/BunPgClient.ts",
    "./package.json": "./package.json"
  },
  "files": ["compiler/src", "runtime/Cargo.toml", "runtime/src", "bun-pg-client/BunPgClient.ts", "contract"],
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "bun test && cd runtime && cargo test --quiet",
    "example:check": "bun compiler/src/cli.ts check examples/todos/api.ts",
    "example:build": "bun compiler/src/cli.ts build examples/todos/api.ts --out examples/todos/rust --release",
    "example:diff": "contract/diff.sh --cases examples/todos/contract-cases.json --reset 'TRUNCATE todos RESTART IDENTITY' --cwd examples/todos 'effect-pg=bun api-pg.ts' 'effect-bunsql=bun api.ts' 'rust=rust/target/release/api_server'"
  },
  "dependencies": {
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@effect/experimental": "*",
    "@effect/sql": ">=0.40.0",
    "@effect/sql-pg": ">=0.40.0",
    "effect": "^3.15.0"
  },
  "peerDependenciesMeta": {
    "@effect/experimental": { "optional": true },
    "@effect/sql": { "optional": true },
    "@effect/sql-pg": { "optional": true },
    "effect": { "optional": true }
  },
  "devDependencies": {
    "@effect/experimental": "0.61.1",
    "@effect/platform": "0.97.2",
    "@effect/platform-bun": "0.91.2",
    "@effect/sql": "0.52.1",
    "@effect/sql-pg": "0.53.0",
    "@types/bun": "^1.3.0",
    "effect": "3.22.2"
  }
}
