{
  "name": "effect2rust",
  "version": "0.1.0",
  "description": "Write the server once in Effect 4; compile it to a native Rust binary that behaves identically. Plus BunPgClient: an effect/sql client on Bun's native Postgres driver.",
  "type": "module",
  "private": true,
  "bin": {
    "effect2rust": "./compiler/src/cli.ts",
    "effect2rust-contract": "./contract/contract.ts"
  },
  "exports": {
    "./BunPgClient": "./bun-pg-client/BunPgClient.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "compiler/src",
    "runtime/Cargo.toml",
    "runtime/src",
    "bun-pg-client/BunPgClient.ts",
    "contract"
  ],
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "bun test && cd runtime && cargo test --quiet",
    "example:check": "bun compiler/src/cli.ts check examples/todos/api.ts",
    "example:build": "bun compiler/src/cli.ts build examples/todos/api.ts --out examples/todos/rust --release",
    "example:diff": "contract/diff.sh --cases examples/todos/contract-cases.json --reset 'TRUNCATE todos RESTART IDENTITY' --cwd examples/todos 'effect=bun api.ts' 'effect-bunpg=bun api-bunpg.ts' 'rust=rust/target/release/api_server'",
    "compare": "bun examples/todos/compare-runtimes.ts"
  },
  "dependencies": {
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "effect": "^4.0.0",
    "@effect/sql-pg": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    },
    "@effect/sql-pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.1",
    "@effect/platform-node": "4.0.1",
    "@effect/sql-pg": "4.0.1",
    "@types/bun": "^1.3.0",
    "effect": "4.0.1"
  }
}
